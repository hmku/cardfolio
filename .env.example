NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CARDFOLIO_OWNER_EMAIL=your-email@example.com

# Optional: keep a read-only copy in a Google Sheet (see README → Google Sheet copy).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
CARDFOLIO_EXPORT_SPREADSHEET_ID=

# Reminders (push notifications). Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
# Vercel sends this to /api/cron/reminders; any long random string.
CRON_SECRET=
